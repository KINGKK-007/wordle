# Development without credentials defaults to mock. Mock syncs tabs in ONE browser profile only.
# On phones/different browsers use firebase. A production build without config shows a setup message.
# Set these in Vercel: Project > Settings > Environment Variables, then rebuild later.
VITE_DUEL_TRANSPORT=mock

# Firebase Console > Project settings > General > Your apps > Web app SDK configuration
# Firebase web configuration is public; database.rules.json enforces authorization.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional public origin for absolute social preview images; auto-detected from Vercel build URLs.
# Set this only to your eventual public site origin (for example, a custom domain).
VITE_SITE_URL=
